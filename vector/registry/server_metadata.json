      "label": "GitHub Copilot",
      "runtime_modes": [
        "local"
      ],
      "install_surface": "repo-local MCP tool provider",
      "default_project_id": "copilot_local",
      "default_toolsets": [
        "core",
        "research",
        "strategy",
        "copy"
      ],
      "default_safe_mode": true,
      "generated_files": [
        ".copilot/mcp-config.json",
        ".github/agents/vector_gtm.agent.md"
      ]
    }
  ],
